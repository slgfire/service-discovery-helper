# Service Discovery Helper configuration
# See README.md for full documentation

[interfaces]
# List one interface per line, or use 'auto' to detect all
# auto
eth0
eth1

[ports]
# One port or port range per line
# See GAMES.md for common game discovery ports

# Source Engine (TF2, CS:GO, etc.)
27015-27020
27005

# Warcraft 3 / Blizzard classics
6111
6112

# Steam (server browser + In-Home Streaming)
26900-26905
4242
27036

# Call of Duty 2/4
28960-28973

# Unreal Tournament 99 / UT2004
8777-8786
10777

[settings]
# Enable rate limiting (strongly recommended)
rate_limit = yes

# Rewrite subnet-directed broadcasts (e.g. 10.0.0.255) to 255.255.255.255
# on forwarded packets. Required when VLANs use different subnets — hosts
# would otherwise drop packets addressed to a foreign subnet broadcast.
rewrite_broadcast = yes

# Rate limit timeout in milliseconds
rate_limit_timeout = 1000

# Log packet statistics to sdh.stat
log_stats = no

# Send logs to syslog instead of stdout
syslog = no

# Enable debug output
debug = no
